{
	"info": {
		"_postman_id": "tickets-auth-03",
		"name": "03 - Tickets Autenticado",
		"description": "Endpoints de tickets accesibles por cualquier usuario autenticado. Requiere token de la colección 01.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Crear Ticket - ALTA",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status 201 Created', function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test('Ticket has id', function () {",
							"    const body = pm.response.json();",
							"    pm.expect(body).to.have.property('id');",
							"    pm.environment.set('ticketId', body.id);",
							"});",
							"",
							"pm.test('Estado is ABIERTO', function () {",
							"    const body = pm.response.json();",
							"    pm.expect(body.estado).to.eql('ABIERTO');",
							"});",
							"",
							"pm.test('SLA for ALTA is 4 hours', function () {",
							"    const body = pm.response.json();",
							"    const created = new Date(body.creadoEn);",
							"    const sla = new Date(body.slaVenceEn);",
							"    const diffHours = (sla - created) / (1000 * 60 * 60);",
							"    pm.expect(diffHours).to.eql(4);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{soporteToken}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"titulo\": \"PC no enciende\",\n  \"descripcion\": \"La computadora del puesto 5 no enciende al presionar el boton de power\",\n  \"prioridad\": \"ALTA\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/tickets",
					"host": ["{{baseUrl}}"],
					"path": ["api", "tickets"]
				}
			},
			"response": []
		},
		{
			"name": "Crear Ticket - MEDIA",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status 201 Created', function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test('SLA for MEDIA is 24 hours', function () {",
							"    const body = pm.response.json();",
							"    const created = new Date(body.creadoEn);",
							"    const sla = new Date(body.slaVenceEn);",
							"    const diffHours = (sla - created) / (1000 * 60 * 60);",
							"    pm.expect(diffHours).to.eql(24);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{soporteToken}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"titulo\": \"Impresora no responde\",\n  \"descripcion\": \"La impresora del area de contabilidad no imprime, muestra error de conexion\",\n  \"prioridad\": \"MEDIA\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/tickets",
					"host": ["{{baseUrl}}"],
					"path": ["api", "tickets"]
				}
			},
			"response": []
		},
