		{
			"name": "Mis Tickets",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response is an array', function () {",
							"    pm.expect(pm.response.json()).to.be.an('array');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{soporteToken}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/tickets/mios",
					"host": ["{{baseUrl}}"],
					"path": ["api", "tickets", "mios"]
				}
			},
			"response": []
		},
		{
			"name": "Ver Ticket por ID",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Ticket has expected fields', function () {",
							"    const body = pm.response.json();",
							"    pm.expect(body).to.have.property('id');",
							"    pm.expect(body).to.have.property('titulo');",
							"    pm.expect(body).to.have.property('descripcion');",
							"    pm.expect(body).to.have.property('prioridad');",
							"    pm.expect(body).to.have.property('estado');",
							"    pm.expect(body).to.have.property('creadoEn');",
							"    pm.expect(body).to.have.property('slaVenceEn');",
							"    pm.expect(body).to.have.property('creadoPor');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{soporteToken}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/tickets/{{ticketId}}",
					"host": ["{{baseUrl}}"],
					"path": ["api", "tickets", "{{ticketId}}"]
				}
			},
			"response": []
		},
		{
			"name": "Ver Ticket inexistente (404)",
