{
	"info": {
		"_postman_id": "tickets-soporte-admin-04",
		"name": "04 - Tickets Soporte/Admin",
		"description": "Endpoints de tickets que requieren rol SOPORTE o ADMIN. Requiere token de la colección 01.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Listar Todos los Tickets",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response is an array', function () {",
							"    pm.expect(pm.response.json()).to.be.an('array');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{soporteToken}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/tickets",
					"host": ["{{baseUrl}}"],
					"path": ["api", "tickets"]
				}
			},
			"response": []
		},
		{
			"name": "Cambiar Estado - EN_PROCESO",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Estado updated to EN_PROCESO', function () {",
							"    const body = pm.response.json();",
							"    pm.expect(body.estado).to.eql('EN_PROCESO');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "PATCH",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{soporteToken}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"nuevoEstado\": \"EN_PROCESO\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/tickets/{{ticketId}}/estado",
					"host": ["{{baseUrl}}"],
					"path": ["api", "tickets", "{{ticketId}}", "estado"]
				}
			},
			"response": []
		},
		{
			"name": "Cambiar Estado - RESUELTO",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Estado updated to RESUELTO', function () {",
							"    const body = pm.response.json();",
							"    pm.expect(body.estado).to.eql('RESUELTO');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "PATCH",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{soporteToken}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"nuevoEstado\": \"RESUELTO\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/tickets/{{ticketId}}/estado",
					"host": ["{{baseUrl}}"],
					"path": ["api", "tickets", "{{ticketId}}", "estado"]
				}
			},
			"response": []
		},
		{
			"name": "Tickets Vencidos",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response is an array', function () {",
							"    pm.expect(pm.response.json()).to.be.an('array');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{soporteToken}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/tickets/vencidos",
					"host": ["{{baseUrl}}"],
					"path": ["api", "tickets", "vencidos"]
				}
			},
			"response": []
		}
	]
}
