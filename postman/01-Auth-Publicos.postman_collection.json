		{
			"name": "Login USUARIO",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response has accessToken and refreshToken', function () {",
							"    const body = pm.response.json();",
							"    pm.expect(body).to.have.property('accessToken');",
							"    pm.expect(body).to.have.property('refreshToken');",
							"    pm.environment.set('usuarioToken', body.accessToken);",
							"    pm.environment.set('usuarioRefreshToken', body.refreshToken);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"usuario@test.com\",\n  \"password\": \"usuario123\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/auth/login",
					"host": ["{{baseUrl}}"],
					"path": ["api", "auth", "login"]
				}
			},
			"response": []
