	"item": [
		{
			"name": "401 - Sin token en ruta protegida",
			"folder": "401 Unauthorized",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status 401 Unauthorized', function () {",
							"    pm.response.to.have.status(401);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/tickets/mios",
					"host": ["{{baseUrl}}"],
					"path": ["api", "tickets", "mios"]
				}
			},
			"response": []
		},
		{
