{
	"info": {
		"_postman_id": "casos-negativos-06",
		"name": "06 - Casos Negativos",
		"description": "Pruebas de seguridad: acceso sin token (401) y con rol insuficiente (403).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
